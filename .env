# Required
BOT_TOKEN=123456:ABC...

# Method 2 — face search
# FaceCheck.ID works without a key. Set only if you have a paid plan.
FACECHECK_API_KEY=
# PimEyes requires a paid API subscription (see pimeyes.com/en/api)
PIMEYES_API_KEY=

# Method 3 — reverse search (optional)
SAUCENAO_KEY=

# Optional tuning
MAX_FILE_MB=20
FACE_SEARCH_COOLDOWN=60
FACE_SEARCH_TIMEOUT=90
